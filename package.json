{
  "name": "kuhhandel",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev:server": "node -e \"require('fs').mkdirSync('web/dist',{recursive:true})\" && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/icons.mjs",
    "test:server": "node -e \"require('fs').mkdirSync('web/dist',{recursive:true})\" && vitest run --config vitest.server.config.ts",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "jsqr": "^1.4.0",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@preact/preset-vite": "^2.10.6",
    "@types/qrcode": "^1.5.6",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "~4.1.12",
    "wrangler": "^4.151.3"
  }
}
